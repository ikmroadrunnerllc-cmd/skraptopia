[sub_resource type="Resource" id="Resource_56fpo"]
script = ExtResource("1_utro4")
lines = Array[String](["Thank you! Leave through the south exit and you will reach the field."])

[sub_resource type="Resource" id="Resource_u1srj"]
script = ExtResource("1_utro4")
lines = Array[String](["The field is just past the south exit. Be careful out there."])

[sub_resource type="Resource" id="Resource_pseu5"]
script = ExtResource("1_utro4")
lines = Array[String](["Thanks to you, the children can play outside again."])

[sub_resource type="Resource" id="Resource_rsgeb"]
script = ExtResource("1_utro4")
lines = Array[String](["I understand. Come back if you change your mind."])

[sub_resource type="Resource" id="Resource_lbacy"]
script = ExtResource("1_utro4")
lines = Array[String](["Ah, a traveler! Welcome to our little village.", "Slimes have started to appear in the field south of here. The children are frightened.", "Would you defeat one for us?"])
choices = Array[String](["I'll do it.", "Not right now."])

[sub_resource type="Resource" id="Resource_bhc8j"]
script = ExtResource("1_utro4")
lines = Array[String](["You defeated the slime! The village is safe again.", "Thank you, traveler. Please take this as thanks."])

[resource]
